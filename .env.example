# Local: run `pnpm db:start` and copy the values it prints (or `pnpm exec supabase status`).
# Hosted: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used by `pnpm admin:create`; never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The public address of the site, used in share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3060

# The request header your host fills in with the visitor's real address (used by the form
# limits). Cloudflare: cf-connecting-ip · Netlify: x-nf-client-connection-ip · Vercel: x-real-ip.
# Leave empty locally.
CLIENT_IP_HEADER=
